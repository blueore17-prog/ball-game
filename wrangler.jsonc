// Cloudflare Worker config: serves the game from public/ and runs worker.mjs for /api/*
{
  "name": "ball-game",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  },
  "kv_namespaces": [
    { "binding": "CHALLENGES", "id": "c12d52a76fd14c41881943efa8815f5b" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "ball", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ]
}
